# Postgres connection (local Mac: your macOS user, no password)
DATABASE_URL=postgresql://alpha:alpha@localhost:5432/alpha

# USD-M perpetuals only (stored as e.g. BTCUSDT.P). Spot candles are off.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,SUIUSDT,TRXUSDT,AAVEUSDT,BNBUSDT,XRPUSDT,HYPEUSDT,LINKUSDT,ADAUSDT,UNIUSDT,LTCUSDT,AVAXUSDT,ATOMUSDT,DOGEUSDT,DOTUSDT,NEARUSDT,OPUSDT,ARBUSDT,WLDUSDT,CAKEUSDT,POLUSDT
PERP_INTERVALS=1m,5m,15m,1h,4h,1d
SPOT_ENABLED=false

# History to load on first run. 1m is large (~525k rows/symbol/year), others load from BACKFILL_START.
BACKFILL_1M_DAYS=365
BACKFILL_START=2017-08-01

# Extra data feeds
FUTURES_ENABLED=true
ORDERFLOW_ENABLED=true
# perp microstructure sampling (book_tick / open_interest_live)
BOOK_TICK_SECONDS=1
OI_POLL_SECONDS=60
