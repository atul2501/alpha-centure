[Unit]
Description=Alpha Centure Binance data collector
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
User=alpha
WorkingDirectory=/opt/alpha
EnvironmentFile=/etc/alpha/.env
ExecStart=/home/alpha/.local/bin/uv run --no-dev python -m alpha.main
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
