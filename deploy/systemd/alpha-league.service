[Unit]
Description=Alpha Centure shadow league: P6 vs pre-registered challengers on live data (research simulator, never trades)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=alpha
WorkingDirectory=/opt/alpha
EnvironmentFile=/etc/alpha/.env
ExecStart=/home/alpha/.local/bin/uv run --no-dev python -m alpha.live.league
Nice=10
TimeoutStartSec=1h
