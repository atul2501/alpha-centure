[Unit]
Description=Alpha Centure history backfill from data.binance.vision (one-shot, resumable)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=alpha
WorkingDirectory=/opt/alpha
EnvironmentFile=/etc/alpha/.env
# History P6 needs (5m-1d candles, premium, OI metrics, book depth). Full 1m candles / aggTrades are not downloaded:
# 1m candles are kept for BACKFILL_1M_DAYS only (freshness checks); for 1m research run
#   python -m alpha.binance.vision --datasets klines,aggTrades --intervals 1m   by hand.
ExecStart=/home/alpha/.local/bin/uv run --no-dev python -m alpha.binance.vision --datasets klines,premium,metrics,bookDepth --intervals 5m,15m,1h,4h,1d
Nice=10
TimeoutStartSec=infinity
