[Unit]
Description=Alpha Centure daily drift check (degrades model + early retrain if needed)
After=postgresql.service

[Service]
Type=oneshot
User=alpha
WorkingDirectory=/opt/alpha
EnvironmentFile=/etc/alpha/.env
ExecStart=/home/alpha/.local/bin/uv run --no-dev python -m alpha.trainer --drift
TimeoutStartSec=3h
